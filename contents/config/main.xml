            <default>0</default>
        </entry>
        <entry name="customInterval" type="Int">
            <default>250</default>
        </entry>
        <entry name="tweeningEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="tweenSpeed" type="Int">
            <default>1</default>
        </entry>
    </group>
</kcfg>
